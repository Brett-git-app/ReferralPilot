Include %occStatus

/// Single-page reviewer dashboard served directly by IRIS.
Class ReferralPilot.UI Extends %CSP.Page
{

ClassMethod OnPage() As %Status
{
    Set %response.ContentType="text/html; charset=utf-8"
    Do %response.SetHeader("Cache-Control","no-store")
    Do %response.SetHeader("X-Content-Type-Options","nosniff")
    Do %response.SetHeader("X-Frame-Options","DENY")
    Do %response.SetHeader("Referrer-Policy","no-referrer")
    Do %response.SetHeader("Content-Security-Policy","default-src 'self'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; connect-src 'self'; img-src 'self' data:; frame-ancestors 'none'")
    Set page=""
    Set page=page_"<!doctype html>"_$C(10)
    Set page=page_"<html lang=""en""><head><meta charset=""utf-8""><meta name=""viewport"" content=""width=device-width,initial-scale=1""><title>ReferralPilot | IRIS workflow</title>"_$C(10)
    Set page=page_"<style>"_$C(10)
    Set page=page_":root{color-scheme:dark;--bg:#0b1020;--panel:#121a2c;--line:#25334b;--muted:#91a1ba;--ink:#ecf3ff;--teal:#49ddc2;--amber:#f6bd60;--red:#ff7186;--blue:#83aaff}*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at 80% -10%,#1c3150 0,transparent 40%),var(--bg);color:var(--ink);font:15px/1.5 Inter,ui-sans-serif,system-ui,-apple-system,""Segoe UI"",sans-serif}header{max-width:1240px;margin:auto;padding:28px 28px 20px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--line)}.brand{display:flex;gap:14px;align-items:center}.mark{height:42px;width:42px;border:1px solid #357e82;border-radius:12px;display:grid;place-items:center;color:var(--teal);font-weight:800;font-size:18px;background:#10252c}h1{font-size:20px;letter-spacing:-.03em;margin:0}.subtitle{color:var(--muted);font-size:12px}.actions{display:flex;gap:9px;flex-wrap:wrap}button{border:1px solid #33445e;background:#17243a;color:var(--ink);padding:9px 13px;border-radius:9px;font-weight:650;cursor:pointer}button:hover{border-color:var(--teal)}button.primary{background:#0e6e68;border-color:#1d9d91}button.danger{color:#ffb1bc}.wrap{max-width:1240px;margin:24px auto;padding:0 28px}.banner{display:flex;justify-content:space-between;gap:20px;align-items:center;border:1px solid #28565a;background:linear-gradient(110deg,#102d35,#14243a);padding:17px 20px;border-radius:14px;margin-bottom:20px}.banner strong{display:block}.banner p{color:#b0c2d7;margin:4px 0 0;font-size:13px}.pill{font-size:11px;border:1px solid #33615e;border-radius:100px;padding:5px 9px;color:var(--teal);white-space:nowrap}.grid{display:grid;grid-template-columns:minmax(300px,.95fr) minmax(400px,1.35fr);gap:18px}.panel{background:#111a2b;border:1px solid var(--line);border-radius:14px;overflow:hidden}.panelhead{padding:17px 18px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between}.panelhead h2{font-size:14px;margin:0}.small{color:var(--muted);font-size:12px}.list{padding:8px}.item{padding:13px 12px;border:1px solid transparent;border-radius:10px;cursor:pointer;margin:3px 0}.item:hover,.item.selected{background:#18243a;border-color:#2e4565}.itemtop{display:flex;justify-content:space-between;gap:8px}.name{font-weight:650}.meta{color:var(--muted);font-size:12px;margin-top:4px}.badge{font-size:10px;text-transform:uppercase;letter-spacing:.04em;border-radius:30px;padding:4px 7px;background:#25344d;color:#c0d0e6;white-space:nowrap}.badge.pending_review{color:#ffd38c;background:#44331f}.badge.needs_information{color:#8fc6ff;background:#1b3552}.badge.approved{color:#75ebc3;background:#163e38}.badge.rejected{color:#ffa0ae;background:#472631}.badge.manual_triage_required{color:#ffc2cc;background:#5b2a36}.badge.triage_retrying{color:#ffd38c;background:#44331f}.detail{padding:20px}.empty{color:var(--muted);padding:38px 12px;text-align:center}.row{display:flex;justify-content:space-between;gap:12px;border-bottom:1px solid #202c40;padding:10px 0}.label{color:var(--muted);font-size:12px}.value{text-align:right;max-width:65%}.section{margin-top:20px}.section h3{font-size:12px;text-transform:uppercase;letter-spacing:.1em;color:#a6b5ca;margin:0 0 9px}.note,.rationale{white-space:pre-wrap;color:#d3deee;background:#0d1524;border:1px solid #202c40;border-radius:9px;padding:12px;font-size:13px}.decision{border:1px solid #394761;background:#151f32;padding:14px;border-radius:11px}.decisionTitle{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:8px}.tag{border:1px solid #344764;border-radius:7px;padding:4px 8px;font-size:11px;color:#bdd0eb}.tag.urgent,.tag.emergency{color:#ff9aa9;border-color:#794452}.tag.soon{color:#ffd38c;border-color:#6b5437}.audit{display:grid;grid-template-columns:125px 1fr;gap:8px;border-left:1px solid #38506e;margin-left:5px;padding:0 0 13px 15px;font-size:12px}.audit:last-child{padding-bottom:0}.audit .time{color:#8193ad}.audit .event{color:#d3deee}.reviewbar{display:flex;gap:8px;margin-top:14px}.foot{color:#76869d;text-align:center;font-size:11px;padding:24px}.toast{position:fixed;bottom:20px;left:50%;transform:translateX(-50%);background:#1b2a3d;border:1px solid #3d5977;border-radius:10px;padding:11px 16px;display:none;box-shadow:0 12px 35px #0008}.toast.show{display:block}@media(max-width:850px){header{align-items:flex-start;gap:16px;flex-direction:column}.grid{grid-template-columns:1fr}.wrap{padding:0 14px}.banner{align-items:flex-start;flex-direction:column}}"_$C(10)
    Set page=page_"</style><style>.modal{display:none;position:fixed;inset:0;background:#000a;place-items:center;z-index:20}.modal.show{display:grid}.sheet{width:min(430px,92vw);background:#111a2b;border:1px solid #2e4565;border-radius:14px;overflow:hidden;box-shadow:0 24px 70px #000a}.form{padding:16px 18px;display:grid;gap:8px}.form select{background:#0d1524;border:1px solid #33445e;color:var(--ink);border-radius:9px;padding:9px 10px;font:inherit}.sheet .reviewbar{padding:0 18px 18px;margin-top:0}</style></head><body>"_$C(10)
    Set page=page_"<header><div class=""brand""><div class=""mark"">RP</div><div><h1>ReferralPilot</h1><div class=""subtitle"">AI-assisted referral triage · InterSystems IRIS AI Hub</div></div></div><div class=""actions""><button id=""reload"">Refresh</button><button id=""demo"" class=""primary"">Load demo cases</button></div></header>"_$C(10)
    Set page=page_"<main class=""wrap""><section class=""banner""><div><strong>Recommendations are advisory. A clinician must review before referral routing.</strong><p>HL7 v2 intake · policy retrieval · agent decision · reviewer approval · HL7 routing</p></div><span id=""pipeline"" class=""pill"">Pipeline…</span><span id=""mode"" class=""pill"">Checking runtime…</span></section>"_$C(10)
    Set page=page_"<div class=""grid""><section class=""panel""><div class=""panelhead""><h2>Incoming referrals</h2><span id=""count"" class=""small"">0 records</span></div><div id=""list"" class=""list""><div class=""empty"">Loading referrals…</div></div></section>"_$C(10)
    Set page=page_"<section class=""panel""><div class=""panelhead""><h2>Review workspace</h2><span class=""small"">Synthetic demo data</span></div><div id=""detail"" class=""detail""><div class=""empty"">Select a referral to inspect the workflow.</div></div></section></div>"_$C(10)
    Set page=page_"<div class=""foot"">ReferralPilot · IRIS persists referral state and audit events · Synthetic data only</div></main><div id=""toast"" class=""toast""></div><div id=""modal"" class=""modal""><div class=""sheet""><div class=""panelhead""><h2 id=""manualTitle"">Complete triage manually</h2><span class=""small"">Human decision</span></div><div class=""form""><label class=""label"" for=""manualSpecialty"">Specialty</label><select id=""manualSpecialty""><option>Cardiology</option><option>Neurology</option><option>Oncology</option><option>Orthopedics</option><option>General Medicine</option></select><label class=""label"" for=""manualUrgency"">Urgency</label><select id=""manualUrgency""><option>ROUTINE</option><option>SOON</option><option>URGENT</option><option>EMERGENCY</option></select></div><div class=""reviewbar""><button class=""primary"" id=""manualSave"">Record triage</button><button id=""manualCancel"">Cancel</button></div></div></div>"_$C(10)
    Set page=page_"<script>"_$C(10)
    Set page=page_"const API='/api/referralpilot';let rows=[],selected='';const $=s=>document.querySelector(s);const esc=s=>String(s??'').replace(/[&<>""']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','""':'&quot;',""'"":'&#39;'}[c]));"_$C(10)
    Set page=page_"async function call(path,method='GET',body){let token=new URLSearchParams(location.search).get('token')||sessionStorage.getItem('referralpilot.token')||'';if(!token&&path!='/health'&&sessionStorage.getItem('referralpilot.tokenRequired')==='1'&&!sessionStorage.getItem('referralpilot.tokenAsked')){sessionStorage.setItem('referralpilot.tokenAsked','1');token=prompt('API token:')||''}if(token)sessionStorage.setItem('referralpilot.token',token);const headers={'Content-Type':'application/json'};if(token)headers['X-ReferralPilot-Token']=token;const r=await fetch(API+path,{method,headers,body:body?JSON.stringify(body):undefined});const d=await r.json();if(path==='/health')sessionStorage.setItem('referralpilot.tokenRequired',d.apiTokenRequired?'1':'0');if(!r.ok)throw Error(d.error||`HTTP ${r.status}`);return d}"_$C(10)
    Set page=page_"function toast(s){$('#toast').textContent=s;$('#toast').classList.add('show');setTimeout(()=>$('#toast').classList.remove('show'),2800)}"_$C(10)
    Set page=page_"async function load(){try{const h=await call('/health');$('#mode').textContent=h.agentKeyConfigured?'LIVE AI · human approval required':'REPLAY MODE · human approval required';const p=await call('/pipeline');$('#pipeline').textContent=`manual queue ${p.manualQueue} · dead letters ${p.deadLetters} · alerts ${p.alerts}`;rows=await call('/referrals');$('#count').textContent=`${rows.length} record${rows.length===1?'':'s'}`;$('#list').innerHTML=rows.length?rows.map(x=>`<div class=""item ${x.id===selected?'selected':''}"" data-id=""${esc(x.id)}""><div class=""itemtop""><span class=""name"">${esc(x.patientLabel||'Synthetic patient')}</span><span class=""badge ${esc(x.status)}"">${esc((x.status||'received').replaceAll('_',' '))}</span></div><div class=""meta"">${esc(x.requestedSpecialty)} · ${esc(x.messageControlId)}</div></div>`).join(''):'<div class=""empty"">No referrals yet. Load the synthetic demo cases.</div>';document.querySelectorAll('.item').forEach(n=>n.onclick=()=>{selected=n.dataset.id;renderDetail()});if(selected&&!rows.some(x=>x.id===selected))selected='';if(!selected&&rows.length)selected=rows[0].id;renderDetail()}catch(e){toast(e.message);$('#list').innerHTML=`<div class=""empty"">API unavailable: ${esc(e.message)}</div>`}}"_$C(10)
    Set page=page_"function renderDetail(){const x=rows.find(y=>y.id===selected);if(!x){$('#detail').innerHTML='<div class=""empty"">Select a referral to inspect the workflow.</div>';return}const r=x.recommendation||{};const pending=['pending_review','needs_information'].includes(x.status);$('#detail').innerHTML=`<div class=""row""><span class=""label"">Referral</span><span class=""value"">${esc(x.id)} · ${esc(x.messageControlId)}</span></div><div class=""row""><span class=""label"">Requested specialty</span><span class=""value"">${esc(x.requestedSpecialty)}</span></div><div class=""row""><span class=""label"">Patient ID</span><span class=""value"">${esc(x.patientId||'not supplied')}</span></div><div class=""section""><h3>Clinical note</h3><div class=""note"">${esc(x.clinicalNote||'No note supplied')}</div></div>${r.specialty?`<div class=""section""><h3>Agent recommendation · ${esc(x.mode||'')}</h3><div class=""decision""><div class=""decisionTitle""><span class=""tag"">${esc(r.specialty)}</span><span class=""tag ${esc((r.urgency||'').toLowerCase())}"">${esc(r.urgency)}</span><span class=""tag"">${(r.missingInformation||[]).length} missing item(s)</span></div><div class=""rationale"">${esc(r.rationale)}</div><div class=""small"" style=""margin-top:9px"">Policy evidence: ${esc(r.policySource||'not recorded')}</div>${(r.missingInformation||[]).length?`<ul>${r.missingInformation.map(m=>`<li>${esc(m)}</li>`).join('')}</ul>`:''}</div>${pending?'<div class=""reviewbar""><button class=""primary"" id=""approve"">Approve</button><button class=""danger"" id=""reject"">Reject</button></div>':''}</div>`:''}${x.status==='manual_triage_required'?`<div class=""section""><h3>Pipeline fallback</h3><div class=""note"">${esc(x.lastError||'Automated triage failed; referral parked for manual triage.')}</div><div class=""reviewbar""><button id=""retry"">Retry automated triage</button><button class=""danger"" id=""manual"">Complete triage manually</button></div></div>`:''}<div class=""reviewbar""><button id=""triage"" class=""primary"">${r.specialty?'Run again':'Run AI triage'}</button></div><div class=""section""><h3>Workflow audit</h3>${(x.audit||[]).map(a=>`<div class=""audit""><span class=""time"">${esc(a.at)}</span><span class=""event""><b>${esc(a.actor)}</b> · ${esc(a.event)}</span></div>`).join('')||'<div class=""small"">No events</div>'}</div>`;$('#triage').onclick=async()=>{try{const out=await call('/triage','POST',{id:x.id});toast(out.mode==='live'?'AI recommendation recorded for review':'Replay recommendation recorded for review');await load()}catch(e){toast(e.message)}};if($('#manual'))$('#manual').onclick=()=>manualTriage(x);if($('#retry'))$('#retry').onclick=async()=>{try{await call(`/referrals/${x.id}/retry`,'POST',{});toast('Automated triage re-queued');await load()}catch(e){toast(e.message)}};if($('#approve'))$('#approve').onclick=()=>review('approved');if($('#reject'))$('#reject').onclick=()=>review('rejected')}"_$C(10)
    Set page=page_"async function review(decision){const comment=prompt(decision==='approved'?'Optional reviewer comment:':'Reason for rejection:')||'';try{await call('/review','POST',{id:selected,decision,reviewer:'Demo Reviewer',comment});toast(`Recommendation ${decision}`);await load()}catch(e){toast(e.message)}}"_$C(10)
    Set page=page_"let manualId='';function closeManual(){$('#modal').classList.remove('show');manualId=''}async function manualTriage(x){manualId=x.id;$('#manualTitle').textContent=`Complete triage manually · ${x.id}`;const options=['Cardiology','Neurology','Oncology','Orthopedics','General Medicine'];$('#manualSpecialty').value=options.includes(x.requestedSpecialty)?x.requestedSpecialty:'General Medicine';$('#manualUrgency').value='URGENT';$('#modal').classList.add('show')}$('#manualSave').onclick=async()=>{if(!manualId)return;try{await call(`/referrals/${manualId}/manual-triage`,'POST',{specialty:$('#manualSpecialty').value,urgency:$('#manualUrgency').value,reviewer:'Demo Reviewer',rationale:'Human reviewer completed triage after automated pipeline fallback.'});closeManual();toast('Manual triage recorded for review');await load()}catch(e){toast(e.message)}};$('#manualCancel').onclick=closeManual;$('#modal').onclick=e=>{if(e.target===$('#modal'))closeManual()};$('#reload').onclick=load;$('#demo').onclick=async()=>{try{await call('/demo/reset','POST',{});selected='';toast('Three synthetic referrals loaded');await load()}catch(e){toast(e.message)}};load();"_$C(10)
    Set page=page_"const renderDetailBase=renderDetail;renderDetail=function(){renderDetailBase();const x=rows.find(y=>y.id===selected);if($('#triage')&&(!x||x.status!=='received'))$('#triage').remove()};review=async function(decision){let reviewer=localStorage.getItem('referralpilot.reviewer')||'';reviewer=prompt('Reviewer identity:',reviewer)||'';if(!reviewer)return;localStorage.setItem('referralpilot.reviewer',reviewer);const comment=prompt(decision==='approved'?'Optional reviewer comment:':'Reason for rejection:')||'';try{await call('/review','POST',{id:selected,decision,reviewer,comment});toast(`Recommendation ${decision}`);await load()}catch(e){toast(e.message)}};$('#manualSave').onclick=async()=>{if(!manualId)return;let reviewer=localStorage.getItem('referralpilot.reviewer')||'';reviewer=prompt('Reviewer identity:',reviewer)||'';if(!reviewer)return;localStorage.setItem('referralpilot.reviewer',reviewer);try{await call(`/referrals/${manualId}/manual-triage`,'POST',{specialty:$('#manualSpecialty').value,urgency:$('#manualUrgency').value,reviewer,rationale:'Human reviewer completed triage after automated pipeline fallback.'});closeManual();toast('Manual triage recorded for review');await load()}catch(e){toast(e.message)}};"_$C(10)
    Set page=page_"</script></body></html>"_$C(10)
    Do %response.Write(page)
    Return $$$OK
}

}
